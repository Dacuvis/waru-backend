# Database Connection
MONGO_URL=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=Cluster0

# Server Port (Injected automatically by Railway)
PORT=3000

# CORS Allowed Frontend Origin
FRONTEND_URL=https://waruu.vercel.app

# Environment
NODE_ENV=production
LOG_LEVEL=info

# JWT Authentication
JWT_SECRET=your_jwt_secret_here_min_32_chars
JWT_EXPIRES_IN=7d

# Email (Resend HTTP API)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=onboarding@your-domain.com

# Midtrans Payment Gateway
MIDTRANS_MERCHANT_ID=M000000000
MIDTRANS_CLIENT_KEY=Mid-client-xxxxxxxx
MIDTRANS_SERVER_KEY=Mid-server-xxxxxxxx
MIDTRANS_IS_PRODUCTION=false

# AI Assistant Integration
AI_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxx
AI_API_KEY=gsk_xxxxxxxxxxxxxxxx
AI_MODEL=openai/gpt-oss-120b
AI_BASE_URL=
AI_TIMEOUT_MS=10000
AI_MAX_HISTORY=6
